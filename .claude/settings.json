{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git-commit.js\"",
            "statusMessage": "Checking for git commit"
          }
        ]
      }
    ]
  }
}
