@using Veloci.Data.Domain
@using Veloci.Web.Controllers.Admin.Teams
@model TeamsViewModel

@{
    ViewData["Title"] = "Teams";
    ViewData["ContentClass"] = "content-wide";
}

<partial name="_Alerts" />

<section class="panel">
    <header class="panel-head">
        <h2 class="panel-title">Teams</h2>
        <div class="d-flex align-items-center gap-3">
            <span class="panel-count" id="teamsCount">@Model.Teams.Count</span>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Create team</button>
        </div>
    </header>
    @if (Model.Teams.Count == 0)
    {
        <div class="panel-body text-muted">No teams created yet.</div>
    }
    else
    {
        <div class="table-toolbar">
            <input type="search" id="teamSearch" class="form-control form-control-sm" placeholder="Search by team, tag or owner…" />
        </div>
        <div class="table-responsive">
            <table class="table" id="teamsTable">
                <thead>
                    <tr>
                        <th data-sort="name">Team</th>
                        <th data-sort="tag">Tag</th>
                        <th data-sort="owner">Owner</th>
                        <th data-sort="members" data-sort-type="number">Members</th>
                        <th data-sort="invites" data-sort-type="number">Invites</th>
                        <th data-sort="createdOn">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Model.Teams)
                    {
                        <tr data-name="@team.Name.ToLowerInvariant()"
                            data-tag="@(team.Tag?.ToLowerInvariant() ?? "")"
                            data-owner="@(team.OwnerPilotName?.ToLowerInvariant() ?? "")"
                            data-members="@team.MemberCount"
                            data-invites="@team.InviteCount"
                            data-created-on="@team.CreatedOn.ToString("s")">
                            <td><a asp-action="Details" asp-route-id="@team.Id">@team.Name</a></td>
                            <td class="mono">@(team.Tag ?? "—")</td>
                            <td class="mono">@(team.OwnerPilotName ?? "—")</td>
                            <td class="mono">@team.MemberCount@(Model.MaxTeamSize > 0 ? $" / {Model.MaxTeamSize}" : "")</td>
                            <td class="mono">@team.InviteCount</td>
                            <td class="mono">@team.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                    <tr id="teamsNoMatch" class="no-match-row d-none">
                        <td colspan="6" class="text-center text-muted">No teams match your search.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create Team</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label mb-1" for="createName">Name</label>
                        <input type="text" name="name" id="createName" class="form-control" maxlength="@Team.NameMaxLength" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label mb-1" for="createTag">Tag</label>
                        <input type="text" name="tag" id="createTag" class="form-control mono" maxlength="@Team.TagMaxLength"
                               minlength="@Team.TagMinLength" pattern="[A-Za-z0-9]+" autocomplete="off" required
                               oninput="this.value = this.value.toUpperCase()" />
                        <div class="form-text">@Team.TagMinLength to @Team.TagMaxLength letters or digits, unique across teams.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label mb-1" for="createOwner">Owner pilot</label>
                        <div class="combobox" data-combobox>
                            <input type="text" name="ownerPilotName" id="createOwner" class="form-control"
                                   placeholder="Type to search…" autocomplete="off" required />
                            <ul class="dropdown-menu combobox-menu">
                                @foreach (var pilotName in Model.OwnerCandidates)
                                {
                                    <li><button type="button" class="dropdown-item">@pilotName</button></li>
                                }
                                <li class="combobox-empty" hidden>No pilots found</li>
                            </ul>
                        </div>
                        <div class="form-text">Only pilots with an account who can own another team are listed.</div>
                    </div>
                    <div>
                        <label class="form-label mb-1" for="createDescription">Description</label>
                        <textarea name="description" id="createDescription" class="form-control" rows="3" maxlength="@Team.DescriptionMaxLength"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const teamsTable = document.getElementById('teamsTable');
        if (teamsTable) {
            const searchInput = document.getElementById('teamSearch');
            const rows = Array.from(teamsTable.querySelectorAll('tbody tr[data-name]'));
            const noMatchRow = document.getElementById('teamsNoMatch');
            const countLabel = document.getElementById('teamsCount');

            searchInput.addEventListener('input', () => {
                const term = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                rows.forEach(row => {
                    const visible = !term || row.dataset.name.includes(term) || row.dataset.tag.includes(term) || row.dataset.owner.includes(term);
                    row.classList.toggle('d-none', !visible);
                    if (visible) visibleCount++;
                });

                noMatchRow.classList.toggle('d-none', visibleCount > 0);
                countLabel.textContent = visibleCount;
            });
        }
    </script>
}
