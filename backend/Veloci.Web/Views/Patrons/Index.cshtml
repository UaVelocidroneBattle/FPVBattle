@using Veloci.Web.Controllers.Admin.Patrons
@model PatronsViewModel

@{
    ViewData["Title"] = "Patrons";
    ViewData["ContentClass"] = "content-wide";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<section class="panel">
    <header class="panel-head">
        <h2 class="panel-title">Patreon Supporters</h2>
        <span class="panel-count" id="patronsCount">@Model.Patrons.Count</span>
    </header>
    @if (Model.Patrons.Count == 0)
    {
        <div class="panel-body text-muted">No Patreon supporters synced yet.</div>
    }
    else
    {
        <div class="table-toolbar">
            <input type="search" id="patronSearch" class="form-control form-control-sm" placeholder="Search by name, email or pilot…" />
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="unlinkedOnlyFilter" />
                <label class="form-check-label" for="unlinkedOnlyFilter">Show only unlinked patrons</label>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table" id="patronsTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Tier</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Supporting Since</th>
                        <th>Pilot</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patron in Model.Patrons)
                    {
                        <tr data-search="@($"{patron.Name} {patron.Email} {patron.PilotName}".ToLowerInvariant())"
                            data-linked="@(patron.PilotName is not null ? "true" : "false")">
                            <td>@patron.Name</td>
                            <td class="mono">@(patron.Email ?? "—")</td>
                            <td>@(patron.TierName ?? "—")</td>
                            <td class="mono">@(patron.Amount?.ToString("0.00") ?? "—")</td>
                            <td>
                                @if (patron.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="mono">@patron.FirstSupportedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (patron.PilotName is not null)
                                {
                                    <span class="mono">@patron.PilotName</span>
                                }
                                else if (patron.SuggestedPilotName is not null)
                                {
                                    <form asp-action="Link" method="post" class="d-flex align-items-center gap-2"
                                          title="A registered user with the same email is linked to this pilot">
                                        <input type="hidden" name="patreonId" value="@patron.PatreonId" />
                                        <input type="hidden" name="pilotName" value="@patron.SuggestedPilotName" />
                                        <span class="badge bg-warning">Match</span>
                                        <span class="mono">@patron.SuggestedPilotName</span>
                                        <button type="submit" class="btn btn-sm btn-success">Link</button>
                                    </form>
                                }
                                else if (patron.HasMatchingUserWithoutPilot)
                                {
                                    <span class="text-muted" title="A registered user with the same email has no pilot linked yet">user found, no pilot</span>
                                }
                                else
                                {
                                    <span class="mono">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button type="button" class="btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                            <circle cx="8" cy="2.5" r="1.5" />
                                            <circle cx="8" cy="8" r="1.5" />
                                            <circle cx="8" cy="13.5" r="1.5" />
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#linkModal"
                                                    data-patreon-id="@patron.PatreonId" data-patron-name="@patron.Name">
                                                @(patron.PilotName is null ? "Link a pilot" : "Change pilot")
                                            </button>
                                        </li>
                                        @if (patron.PilotName is not null)
                                        {
                                            <li>
                                                <form asp-action="Unlink" method="post" onsubmit="return confirm('Are you sure?');">
                                                    <input type="hidden" name="patreonId" value="@patron.PatreonId" />
                                                    <button type="submit" class="dropdown-item text-danger">Unlink patron from pilot</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="patronsNoMatch" class="d-none">
                        <td colspan="8" class="text-center text-muted">No patrons match your search.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

<div class="modal fade" id="linkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Link" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Link <span id="linkModalPatronName"></span> to a Pilot</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label mb-1" for="linkModalPilotName">Pilot</label>
                    <input type="text" name="pilotName" id="linkModalPilotName" class="form-control"
                           list="unlinkedPilots" placeholder="Start typing to search unlinked pilots…" autocomplete="off" required />
                    <datalist id="unlinkedPilots">
                        @foreach (var pilotName in Model.UnlinkedPilotNames)
                        {
                            <option value="@pilotName"></option>
                        }
                    </datalist>
                </div>
                <input type="hidden" name="patreonId" id="linkModalPatreonId" />
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Link</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('linkModal').addEventListener('show.bs.modal', function (event) {
            const trigger = event.relatedTarget;
            document.getElementById('linkModalPatreonId').value = trigger.dataset.patreonId;
            document.getElementById('linkModalPatronName').textContent = trigger.dataset.patronName;
            document.getElementById('linkModalPilotName').value = '';
        });

        const patronsTable = document.getElementById('patronsTable');
        if (patronsTable) {
            const searchInput = document.getElementById('patronSearch');
            const unlinkedOnlyFilter = document.getElementById('unlinkedOnlyFilter');
            const rows = Array.from(patronsTable.querySelectorAll('tbody tr[data-search]'));
            const noMatchRow = document.getElementById('patronsNoMatch');
            const countLabel = document.getElementById('patronsCount');

            function applyFilters() {
                const term = searchInput.value.trim().toLowerCase();
                const onlyUnlinked = unlinkedOnlyFilter.checked;
                let visibleCount = 0;

                rows.forEach(row => {
                    const visible = (!term || row.dataset.search.includes(term))
                        && (!onlyUnlinked || row.dataset.linked === 'false');

                    row.classList.toggle('d-none', !visible);
                    if (visible) visibleCount++;
                });

                noMatchRow.classList.toggle('d-none', visibleCount > 0);
                countLabel.textContent = visibleCount;
            }

            searchInput.addEventListener('input', applyFilters);
            unlinkedOnlyFilter.addEventListener('change', applyFilters);
        }
    </script>
}
